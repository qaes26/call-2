# ===================================================================
# تكوين البيئة لتطبيق "أبوي وأمي" (My Parents Call) - عائلة أبو قيس
# ===================================================================
PORT=3000
NODE_ENV=production

# النطاق المسموح به (تم ضبطه على * ليعمل تلقائياً على أي سيرفر أو رابط استضافة)
ALLOWED_ORIGIN=*

# رموز PIN السرية المخصصة لكل فرد في العائلة:
# 1. قيس (الابن)
PIN_SON=20052006
# 2. الأب (أبو قيس)
PIN_FATHER=1973
# 3. الأم (أم قيس)
PIN_MOTHER=332211

# مفتاح التشفير الخاص برموز JWT
JWT_SECRET=super_secure_jwt_secret_parents_call_2026_xyz987654321_protect_family
JWT_EXPIRES_IN=2h

# مفتاح السيرفر المشترك لتوليد بيانات TURN المؤقتة (Coturn static-auth-secret)
TURN_SHARED_SECRET=coturn_secure_family_secret_key_89234892374

# خوادم STUN و TURN الافتراضية
STUN_SERVER_URL=stun:stun.cloudflare.com:3478
TURN_SERVER_URL=
TURN_SERVER_URLS=
