# ===================================================================
# تكوين البيئة لتطبيق "أبوي وأمي" (My Parents Call) - عائلة أبو قيس
# ===================================================================
PORT=3000
NODE_ENV=development

# النطاق المسموح به لسياسة CORS
ALLOWED_ORIGIN=http://localhost:3000

# رموز PIN السرية المخصصة لكل فرد:
PIN_SON=20052006
PIN_FATHER=1973
PIN_MOTHER=332211

# مفتاح التشفير الخاص برموز JWT
JWT_SECRET=super_secure_jwt_secret_parents_call_2026_xyz987654321_protect_family
JWT_EXPIRES_IN=2h

# مفتاح السيرفر المشترك لتوليد بيانات TURN المؤقتة (Coturn static-auth-secret)
TURN_SHARED_SECRET=your_coturn_static_auth_secret_here_change_me

# خوادم STUN و TURN
STUN_SERVER_URL=stun:stun.cloudflare.com:3478
TURN_SERVER_URL=
TURN_SERVER_URLS=
