[Unit]
Description=Parents Call WebRTC Signaling Service (أبوي وأمي)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/parents-call
ExecStart=/usr/bin/node server/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
LimitNOFILE=65536

# عزل أمني إضافي للعملية (Linux Hardening)
ProtectSystem=full
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
